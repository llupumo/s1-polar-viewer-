# --- Generated by the scripts: rebuild with build_quicklooks.py / fetch_land.py ---
site/data/*.png
site/data/index.json
site/data/land.json
# keep the (empty) folder in git
!site/data/.gitkeep

# --- Input data: never commit SAR rasters or other large files ---
*.tif
*.tiff
*.nc
*.zip
*.SAFE/
*.geojson

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- HPC / logs ---
*.log
slurm-*.out
